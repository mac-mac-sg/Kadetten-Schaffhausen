{
  "name": "kadetten-staging",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "preview_urls": false,
  "build": {"command": "npm run build"},
  "assets": {"directory": "dist/client", "binding": "ASSETS", "run_worker_first": true},
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "kadetten-staging-data"}],
  "vars": {"KADETTEN_AUTH_PROVIDER": "cloudflare-access"}
}
