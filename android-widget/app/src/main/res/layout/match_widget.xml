<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview"
    android:contentDescription="@string/open_match">
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/heading" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/preview"
            android:fontFamily="@font/barlow_score" android:textColor="#FF8A4D" android:textSize="17sp"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/league" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/inter_text" android:textColor="#D2D0CE" android:textSize="11sp" android:maxLines="1"/>
        <ImageView android:id="@+id/refresh" android:layout_width="44dp" android:layout_height="match_parent"
            android:padding="10dp" android:src="@drawable/ic_refresh" android:contentDescription="@string/refresh"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center">
            <ImageView android:id="@+id/home_logo" android:layout_width="38dp" android:layout_height="38dp"
                android:scaleType="fitCenter" android:src="@drawable/ic_shield" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/home_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:gravity="center" android:maxLines="2" android:ellipsize="end"
                android:text="@string/home" android:fontFamily="@font/inter_text" android:textColor="#F6F3EE" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="92dp" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/score" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="@string/versus" android:textColor="#F6F3EE"
                android:fontFamily="@font/barlow_score" android:textSize="42sp"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="24sp" android:autoSizeMaxTextSize="42sp"
                android:autoSizeStepGranularity="1sp" android:maxLines="1" android:includeFontPadding="false"/>
            <TextView android:id="@+id/score_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="@string/kickoff" android:textColor="#D2D0CE"
                android:fontFamily="@font/inter_text" android:textSize="10sp" android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center">
            <ImageView android:id="@+id/away_logo" android:layout_width="38dp" android:layout_height="38dp"
                android:scaleType="fitCenter" android:src="@drawable/ic_shield" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/away_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:gravity="center" android:maxLines="2" android:ellipsize="end"
                android:text="@string/away" android:fontFamily="@font/inter_text" android:textColor="#F6F3EE" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="center" android:text="@string/loading"
        android:fontFamily="@font/inter_text" android:textColor="#F6F3EE" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/last_result" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="center" android:visibility="gone"
        android:fontFamily="@font/inter_text" android:textColor="#D2D0CE" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="center" android:text="@string/state"
        android:fontFamily="@font/inter_text" android:textColor="#BBB8B5" android:textSize="10sp" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>
