{
  "name": "kadetten-schaffhausen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev-app.mjs",
    "dev:app": "node scripts/dev-app.mjs",
    "build": "node scripts/build-pages.mjs",
    "build:app": "node scripts/build-app.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node scripts/check.mjs",
    "format": "prettier --write src/kadetten/js",
    "format:check": "prettier --check src/kadetten/js",
    "build:pages": "node scripts/build-pages.mjs",
    "verify": "npm run check && npm test && npm run build:pages && node scripts/check-pages.mjs",
    "test:archiv": "node --test \"archive/matchday/tests/*.test.mjs\""
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "5.2.8",
    "@fontsource/inter": "5.2.8",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "pdfjs-dist": "^5.4.149",
    "prettier": "3.6.2"
  }
}
